# Copy to config.yml (which git ignores) and fill in.

# Outgoing mail server. Example for gmail, which needs an App Password:
# https://myaccount.google.com/apppasswords
SMTP_SERVER: smtp.gmail.com
SMTP_PORT: 587
USERNAME: you@gmail.com
PASSWORD: "your-app-password"

# Used for the Date on the emails. Optional, defaults to UTC.
TIMEZONE: 'Australia/Melbourne'

# Who's in the draw. Any number of people (2 or more), odd numbers are fine.
# Comment someone out with # to leave them out this year.
PARTICIPANTS:
  - Chad <chad@somewhere.net>
  - Jen <jen@gmail.net>
  - Bill <Bill@somedomain.net>
  - Sharon <Sharon@hi.org>
  # - Pat <pat@example.com>

# People on the same line never draw each other. Usually couples, but a line
# can have more names (e.g. a household). Names must match PARTICIPANTS exactly;
# it's fine to mention someone who's sitting this year out.
COUPLES:
  - Chad, Jen
  - Bill, Sharon

# Every --send saves the draw in history/<year>.yml. Later draws avoid the
# pairs from this many previous years. Optional, default 2; 0 ignores history.
# If the draw says it's impossible (lots of couples, small group), lower it.
AVOID_YEARS: 2

# Draws from before you used this version? Add them as history/<year>.yml:
#   PAIRS:
#     - Chad, Sharon
# (LAST_YEAR from older configs still works, but applies forever, so prefer history/.)

# The organiser, in case anyone has questions.
FROM: You <you@gmail.com>

# SUBJECT and MESSAGE can use {santa} (who's buying), {santee} (who they're
# buying for) and {year}. Keep {santee} out of the subject: it shows up in
# inbox previews and phone notifications.
SUBJECT: Your {year} secret santa person is...
MESSAGE: |
  Dear {santa},

  This year you are {santee}'s Secret Santa! Ho Ho Ho!

  The spending limit is 50.

  Merry Christmas!
